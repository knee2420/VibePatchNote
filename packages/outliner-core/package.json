    },
    "./model": {
      "import": "./src/model/index.ts",
      "types": "./src/model/index.ts"
    },
    "./transforms": {
      "import": "./src/transforms/index.ts",
      "types": "./src/transforms/index.ts"
    },
    "./queries": {
      "import": "./src/queries/index.ts",
      "types": "./src/queries/index.ts"
    },
    "./views": {
      "import": "./src/views/index.ts",
      "types": "./src/views/index.ts"
    }
  },
  "dependencies": {
    "immer": "^11.1.21",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint"
  }
