{
  "name": "@vibe/outliner-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./outline": {
      "import": "./src/outline/index.ts",
      "types": "./src/outline/index.ts"
    },
    "./workspace": {
      "import": "./src/workspace/index.ts",
      "types": "./src/workspace/index.ts"
    },
    "./model": {
      "import": "./src/outline/model/index.ts",
      "types": "./src/outline/model/index.ts"
    },
    "./transforms": {
      "import": "./src/outline/transforms/index.ts",
      "types": "./src/outline/transforms/index.ts"
    },
    "./queries": {
      "import": "./src/outline/queries/index.ts",
      "types": "./src/outline/queries/index.ts"
    },
    "./views": {
      "import": "./src/outline/views/index.ts",
      "types": "./src/outline/views/index.ts"
    }
  },
  "dependencies": {
    "immer": "^11.1.21"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "tsx --test test/workspace.test.ts"
  }
